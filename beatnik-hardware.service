[Unit]
Description=Beatnik Hardware Configuration Service
After=network.target

[Service]
# Must run as root for /boot/firmware/config.txt access
User=root
# Paths match the Debian package; setup.sh patches them for the script install
WorkingDirectory=/opt/beatnik-hardware-api
ExecStart=/opt/beatnik-hardware-api/beatnik-hardware-api
Restart=always
# Log level, e.g. debug or info,tower_http=warn
Environment=RUST_LOG=info
# Optional: override the path to config.txt
# Environment=CONFIG_PATH=/boot/firmware/config.txt

[Install]
WantedBy=multi-user.target
